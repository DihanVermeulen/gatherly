# Expo dev server URL for magic link deep linking during development.
# Set to your machine's LAN IP and Expo port (found in `npx expo start` output).
# Remove or leave blank for production builds (falls back to intent:// for Android).
# Format: exp://HOST:PORT (no trailing slash)
NEXT_PUBLIC_EXPO_URL=exp://192.168.0.100:8081

# Android package name used for intent:// deep link fallback in production.
NEXT_PUBLIC_APP_PACKAGE=com.gatherly.gatherly
